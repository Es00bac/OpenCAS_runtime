{
  "manifest_version": 1,
  "id": "desktop_context",
  "name": "Desktop Context",
  "description": "Toggleable body-double skill that captures the active desktop, creates context from screenshots/OCR/vision analysis, and can speak short local TTS nudges when useful.",
  "version": "1.0.0",
  "entrypoint": "main.py",
  "config_schema": {
    "type": "object",
    "properties": {
      "enabled": {"type": "boolean"},
      "capture_interval_seconds": {"type": "integer"},
      "min_speech_interval_seconds": {"type": "integer"},
      "tts_enabled": {"type": "boolean"},
      "play_audio": {"type": "boolean"},
      "vision_enabled": {"type": "boolean"},
      "ocr_enabled": {"type": "boolean"},
      "capture_backend": {"type": "string"},
      "vision_model": {"type": "string"},
      "session_id": {"type": "string"},
      "declared_task": {"type": "string"},
      "declared_task_source": {"type": "string"},
      "declared_task_updated_at": {"type": "string"},
      "speech_relevance_threshold": {"type": "number"},
      "youtube_transcripts_enabled": {"type": "boolean"},
      "youtube_transcript_max_chars": {"type": "integer"},
      "yt_dlp_path": {"type": "string"},
      "live_transcription_enabled": {"type": "boolean"},
      "live_transcription_capture_seconds": {"type": "number"},
      "live_transcription_min_interval_seconds": {"type": "number"},
      "live_transcription_max_chars": {"type": "integer"},
      "live_transcription_whisper_model": {"type": "string"},
      "live_transcription_audio_input": {"type": "string"},
      "live_transcription_ffmpeg_path": {"type": "string"},
      "live_transcription_whisper_path": {"type": "string"},
      "live_transcription_timeout_seconds": {"type": "integer"},
      "observed_context_relevance_enabled": {"type": "boolean"},
      "observed_context_relevance_match_threshold": {"type": "number"},
      "observed_context_relevance_interrupt_threshold": {"type": "number"},
      "project_context_relevance_enabled": {"type": "boolean"},
      "proactive_video_commentary_enabled": {"type": "boolean"},
      "livestream_resume_catchup_enabled": {"type": "boolean"},
      "livestream_resume_catchup_rate": {"type": "number"},
      "livestream_resume_catchup_max_seconds": {"type": "number"},
      "max_image_bytes": {"type": "integer"},
      "vision_max_dimension": {"type": "integer"},
      "vision_jpeg_quality": {"type": "integer"}
    }
  },
  "default_config": {
    "enabled": false,
    "capture_interval_seconds": 60,
    "min_speech_interval_seconds": 60,
    "tts_enabled": true,
    "play_audio": true,
    "vision_enabled": true,
    "ocr_enabled": true,
    "capture_backend": "auto",
    "declared_task": "",
    "speech_relevance_threshold": 0.65,
    "youtube_transcripts_enabled": true,
    "youtube_transcript_max_chars": 12000,
    "live_transcription_enabled": false,
    "live_transcription_capture_seconds": 6,
    "live_transcription_min_interval_seconds": 12,
    "live_transcription_max_chars": 1600,
    "live_transcription_whisper_model": "base",
    "live_transcription_timeout_seconds": 45,
    "observed_context_relevance_enabled": true,
    "observed_context_relevance_match_threshold": 0.62,
    "observed_context_relevance_interrupt_threshold": 0.82,
    "project_context_relevance_enabled": true,
    "proactive_video_commentary_enabled": true,
    "livestream_resume_catchup_enabled": true,
    "livestream_resume_catchup_rate": 1.5,
    "livestream_resume_catchup_max_seconds": 90,
    "max_image_bytes": 5000000,
    "vision_max_dimension": 1600,
    "vision_jpeg_quality": 82
  },
  "capabilities": [
    {
      "capability_id": "plugin:desktop_context.observe",
      "display_name": "Desktop Context Observation",
      "kind": "tool",
      "description": "Capture the active desktop and decide whether a short collaborative comment should be spoken.",
      "tool_names": [
        "desktop_context_status",
        "desktop_context_configure",
        "desktop_context_set_task",
        "desktop_context_capture",
        "desktop_context_observe",
        "desktop_context_speak"
      ]
    }
  ]
}
